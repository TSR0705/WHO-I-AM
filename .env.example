# Example environment variables for Who Am I app

# DATABASE URL (required for Vercel - use Vercel Postgres, AWS RDS, or similar)
DATABASE_URL=postgresql://user:password@localhost:5432/whoami

# Redis URL (optional — recommended for production)
REDIS_URL=redis://localhost:6379

# Geo provider: set to 'ipapi' to enable external geolocation (optional)
GEO_PROVIDER=geoip
GEO_API_KEY=

# Restrict CORS origin (set to your frontend domain in production)
ALLOWED_ORIGIN=https://yourdomain.com

# Whether Express should trust proxy headers (set to '1' when behind a proxy/load balancer)
TRUST_PROXY=1

# Logging level: info, debug, warn, error
LOG_LEVEL=info

# Node Environment
NODE_ENV=production

# Frontend API URL (for frontend to call backend)
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
